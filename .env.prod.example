# Copia este archivo como .env.prod (ignorado por Git) para compilar producción.
# No lo usa Next automáticamente: lo carga scripts/deploy-prod.mjs.
# Nunca pongas SUPABASE_SECRET_KEY aquí. Ese valor va como secreto del Worker.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable
NEXT_PUBLIC_SITE_URL=https://donko-partituras.tu-subdominio.workers.dev

# Correo del único administrador. Debe coincidir con el usuario confirmado de Supabase Auth.
ADMIN_EMAIL=admin@ejemplo.cl
