{
  "name": "donko-partituras-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/library-text.test.mjs tests/library-validation.test.mjs tests/library-pdf.test.mjs tests/storage-paths.test.mjs tests/auth.test.mjs tests/library-operations.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/deploy-prod.mjs --allow-same-supabase",
    "upload": "node scripts/deploy-prod.mjs --upload --allow-same-supabase",
    "deploy:check": "node scripts/deploy-prod.mjs --dry-run --allow-same-supabase",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:secure": "node scripts/apply-migrations.mjs --disable-signup",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.154.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true
  }
}
