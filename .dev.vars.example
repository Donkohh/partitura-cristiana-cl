# Copia este archivo como .dev.vars (ignorado por Git) para preview local en Workers.
# No uses estos valores para producción.

NEXTJS_ENV=development

# Deben coincidir con .env.local. En producción se configuran como secretos
# del Worker, no como variables públicas.
ADMIN_EMAIL=admin@ejemplo.cl
SUPABASE_SECRET_KEY=tu-clave-secreta

# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY y
# NEXT_PUBLIC_SITE_URL se incrustan en tiempo de build desde .env.local.
