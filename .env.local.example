# Copia este archivo como .env.local (ignorado por Git) para desarrollo.
# Para producción usa .env.prod.example y scripts/deploy-prod.mjs.
# Las variables NEXT_PUBLIC_* se incrustan en el bundle durante el build.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable

# URL pública del sitio (metadatos, robots y sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Correo del único administrador. Debe coincidir con el usuario creado
# manualmente en Supabase Auth y estar confirmado.
ADMIN_EMAIL=admin@ejemplo.cl

# Clave secreta de Supabase. SOLO servidor: nunca usar NEXT_PUBLIC_*.
# Se usa para lecturas administrativas, escrituras y URLs firmadas.
SUPABASE_SECRET_KEY=tu-clave-secreta
