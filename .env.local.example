# Copia este archivo como .env.local (ignorado por Git) para desarrollo.
# Solo variables públicas. Los secretos van en .dev.vars (ver .dev.vars.example).
# No pongas SUPABASE_SECRET_KEY ni ADMIN_EMAIL aquí: OpenNext los incrustaría
# en el Worker al compilar.
# Las variables NEXT_PUBLIC_* se incrustan en el bundle durante el build.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-publishable

# URL pública del sitio (metadatos, robots y sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
